{# templates/compose.html.twig — v2 compose form, mail-client layout. #}
{% set tickets_id = tickets_id|default(0) %}
{% set subject = subject|default('') %}
{% set errors = errors|default([]) %}
{% set recipients_to_raw = recipients_to_raw|default(recipients_to|default([])|join(', ')) %}
{% set recipients_cc_raw = recipients_cc_raw|default(recipients_cc|default([])|join(', ')) %}
{% set recipients_bcc_raw = recipients_bcc_raw|default(recipients_bcc|default([])|join(', ')) %}
{% set mailbox_matches = mailbox_matches|default([]) %}
{% set mailbox_override = mailbox_override|default(false) %}
{% set new_conversation = new_conversation|default(false) %}
{% set form_id = form_id|default('ticketmailer-compose') %}
{% set close_target = close_target|default('') %}
{% set followup_template_dropdown = followup_template_dropdown|default('') %}
{% set solution_template_dropdown = solution_template_dropdown|default('') %}
{% set followup_source_dropdown = followup_source_dropdown|default('') %}
{% set include_history = include_history|default(false) %}
{% set history_attachments = history_attachments|default([]) %}
{% set selected_history_attachments = selected_history_attachments|default([]) %}
{% set native_followup_form = native_followup_form|default('') %}
<div data-ticketmailer-delivery
     data-email-title="{{ __('E-Mail antworten', 'ticketmailer') }}"
     data-note-title="{{ __('Internal note', 'ticketmailer') }}"
     data-cancel-label="{{ __('Cancel', 'ticketmailer') }}"
     data-close-target="{{ close_target }}"
     data-knowledge-label="{{ __('Knowledge base', 'ticketmailer') }}"
     data-answer-templates-label="{{ __('Answer templates', 'ticketmailer') }}"
     data-choose-files-label="{{ __('Choose files', 'ticketmailer') }}"
     data-drop-files-label="{{ __('Drag & drop your file here, or choose files.', 'ticketmailer') }}"
     data-private-label="{{ __('Private') }}"
     data-save-knowledge-label="{{ __('Save and add to the knowledge base') }}"
     data-waiting-label="{{ __('Set ticket status to waiting after sending.', 'ticketmailer') }}"
     data-solved-label="{{ __('Set ticket status to solved after sending.', 'ticketmailer') }}">
    <fieldset class="ticketmailer-delivery-mode d-flex gap-3 mb-3">
        <legend class="visually-hidden">{{ __('Reply mode', 'ticketmailer') }}</legend>
        <label>
            <input type="radio" name="delivery_mode_{{ form_id }}" data-delivery-mode value="email" checked>
            {{ __('Email', 'ticketmailer') }}
        </label>
        {% if native_followup_form is not empty %}
        <label>
            <input type="radio" name="delivery_mode_{{ form_id }}" data-delivery-mode value="internal_note">
            {{ __('Internal note', 'ticketmailer') }}
        </label>
        {% endif %}
    </fieldset>
<div data-ticketmailer-panel="email">
<form method="post"
      action="{{ send_url }}"
      enctype="multipart/form-data"
      class="ticketmailer-compose"
      id="{{ form_id }}"
  data-upload-url="{{ upload_url }}"
  data-image-url="{{ image_url }}"
  data-validate-url="{{ validate_url|default('') }}"
  data-user-autocomplete-url="{{ user_autocomplete_url|default('') }}"
  data-user-autocomplete-show-email="{{ user_autocomplete_show_email ? '1' : '0' }}"
  data-ajax-csrf="{{ ajax_csrf }}"
  data-followup-template-url="{{ followup_template_url|default('') }}"
  data-solution-template-url="{{ solution_template_url|default('') }}"
  data-editor-id="{{ editor_id|default('body_html') }}"
  data-i18n-remove-recipient="{{ __('Remove %s', 'ticketmailer') }}"
  data-i18n-bytes="{{ __('bytes', 'ticketmailer') }}"
  data-i18n-upload-failed="{{ __('Upload failed.', 'ticketmailer') }}"
  data-i18n-mailbox-recipient="{{ __('This address may not receive the message because GLPI uses the ticket number to assign it to this ticket instead of creating a new ticket.', 'ticketmailer') }}"
  data-mailbox-matches="{{ mailbox_matches|json_encode|e('html_attr') }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="delivery_mode" value="email">
    <input type="hidden" name="tickets_id" value="{{ tickets_id }}">

    <div class="ticketmailer-mail-panel">
        {% if errors %}
            <div class="ticketmailer-errors" role="alert">
                <ul>
                    {% for e in errors %}
                        <li>{{ e }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="ticketmailer-mail-row">
            <label class="ticketmailer-mail-label" for="{{ form_id }}-recipients_to-input">{{ __('To', 'ticketmailer') }}</label>
            <div class="ticketmailer-mail-field ticketmailer-recipient-control" data-recipient-control>
                <div class="ticketmailer-recipient-chips"></div>
                <input type="text" id="{{ form_id }}-recipients_to-input" class="ticketmailer-recipient-input"
                       placeholder="{{ __('user@example.org, …', 'ticketmailer') }}" autocomplete="off">
                <button type="button" class="ticketmailer-recipient-clear" aria-label="{{ __('Clear', 'ticketmailer') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
                <input type="hidden" id="{{ form_id }}-recipients_to" name="recipients_to"
                       value="{{ recipients_to_raw }}">
            </div>
        </div>

        <div class="ticketmailer-mail-row">
            <label class="ticketmailer-mail-label" for="{{ form_id }}-recipients_cc-input">{{ __('CC', 'ticketmailer') }}</label>
            <div class="ticketmailer-mail-field ticketmailer-recipient-control" data-recipient-control>
                <div class="ticketmailer-recipient-chips"></div>
                <input type="text" id="{{ form_id }}-recipients_cc-input" class="ticketmailer-recipient-input" autocomplete="off">
                <button type="button" class="ticketmailer-recipient-clear" aria-label="{{ __('Clear', 'ticketmailer') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
                <input type="hidden" id="{{ form_id }}-recipients_cc" name="recipients_cc"
                       value="{{ recipients_cc_raw }}">
            </div>
        </div>

        <div class="ticketmailer-mail-row">
            <label class="ticketmailer-mail-label" for="{{ form_id }}-recipients_bcc-input">{{ __('BCC', 'ticketmailer') }}</label>
            <div class="ticketmailer-mail-field ticketmailer-recipient-control" data-recipient-control>
                <div class="ticketmailer-recipient-chips"></div>
                <input type="text" id="{{ form_id }}-recipients_bcc-input" class="ticketmailer-recipient-input" autocomplete="off">
                <button type="button" class="ticketmailer-recipient-clear" aria-label="{{ __('Clear', 'ticketmailer') }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
                <input type="hidden" id="{{ form_id }}-recipients_bcc" name="recipients_bcc"
                       value="{{ recipients_bcc_raw }}">
            </div>
        </div>

        <div class="ticketmailer-mail-row">
            <label class="ticketmailer-mail-label" for="{{ form_id }}-subject">{{ __('Subject', 'ticketmailer') }}</label>
            <span class="ticketmailer-subject-marker" data-ticketmailer-subject-marker {% if new_conversation %}hidden{% endif %}>[GLPI #{{ tickets_id }}]</span>
            <input type="text" class="ticketmailer-mail-field" id="{{ form_id }}-subject" name="subject" value="{{ subject }}" required>
        </div>
        <div class="ticketmailer-mail-row">
            <span class="ticketmailer-mail-label"></span>
            <label class="form-check">
                <input type="checkbox" class="form-check-input" name="new_conversation" value="1"
                       data-ticketmailer-new-conversation {% if new_conversation %}checked{% endif %}>
                {{ __('Start a new conversation', 'ticketmailer') }}
                <span class="ticketmailer-help">{{ __('Replies may create a new ticket.', 'ticketmailer') }}</span>
            </label>
        </div>

        {% if followup_template_dropdown or solution_template_dropdown or followup_source_dropdown %}
            <div class="ticketmailer-mail-row ticketmailer-mail-row--followup-meta">
                {% if followup_template_dropdown %}
                    <div class="ticketmailer-mail-field">
                        {{ followup_template_dropdown|raw }}
                    </div>
                {% endif %}
                {% if solution_template_dropdown %}
                    <div class="ticketmailer-mail-field">
                        {{ solution_template_dropdown|raw }}
                    </div>
                {% endif %}
                {% if followup_source_dropdown %}
                    <div class="ticketmailer-mail-field">
                        {{ followup_source_dropdown|raw }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <div class="ticketmailer-mail-row ticketmailer-mail-row--editor">
            <div class="ticketmailer-mail-field ticketmailer-editor">
                {{ body_editor|raw }}
            </div>
        </div>


        <div class="ticketmailer-mail-row">
            <div class="ticketmailer-mail-field">
                <label>
                    <input type="checkbox" name="include_history" value="1"
                           {% if include_history %}checked{% endif %}>
                    {{ __('Attach public ticket history', 'ticketmailer') }}
                </label>
            </div>
        </div>

        <div class="ticketmailer-mail-row ticketmailer-mail-row--attach">
            <div class="ticketmailer-mail-field ticketmailer-attach" data-attachment-drop>
                <input type="file" id="{{ form_id }}-file" class="ticketmailer-file" multiple hidden>
                <button type="button" class="btn btn-secondary ticketmailer-choose-files">
                    {{ __('Choose files', 'ticketmailer') }}
                </button>
                <div data-history-attachments>
                    {% if history_attachments is empty %}
                        <p class="ticketmailer-help">
                            {{ __('No public ticket attachments are available.', 'ticketmailer') }}
                        </p>
                    {% else %}
                        <ul class="ticketmailer-attachments">
                            {% for attachment in history_attachments %}
                                <li>
                                    <label>
                                        <input type="checkbox" name="history_attachments[]"
                                               value="{{ attachment.id }}"
                                               {% if attachment.id in selected_history_attachments %}checked{% endif %}>
                                        {{ attachment.filename }}
                                    </label>
                                    <a class="ticketmailer-attachment-open"
                                       href="{{ attachment.preview_url }}" target="_blank" rel="noopener"
                                       aria-label="{{ __('Open attachment', 'ticketmailer') }}"
                                       title="{{ __('Open attachment', 'ticketmailer') }}">
                                        <i class="ti ti-external-link" aria-hidden="true"></i>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <ul id="{{ form_id }}-attachments" class="ticketmailer-attachments"></ul>
                <p class="ticketmailer-help">
                    {{ __('Drag & drop your file here, or choose files.', 'ticketmailer') }}
                </p>
            </div>
        </div>
    </div>

    <div class="ticketmailer-mailbox" id="{{ form_id }}-mailbox-warning"
         {% if mailbox_matches is empty %}hidden{% endif %}>
        <p><i class="ti ti-alert-triangle" aria-hidden="true"></i>
            {{ __('The intended recipient may not receive the message because GLPI uses the ticket number to assign it to this ticket instead of creating a new ticket.', 'ticketmailer') }}
        </p>
        <p><strong>{{ __('Affected addresses:', 'ticketmailer') }}</strong>
            <code class="ticketmailer-mailbox-matches">{{ mailbox_matches|join(', ') }}</code>
        </p>
        <p class="ticketmailer-help">
            {{ __('Aliases, forwarding, and non-email logins are not detected.', 'ticketmailer') }}
        </p>
        <label>
            <input type="checkbox" name="mailbox_override" value="1"
                   {% if mailbox_override %}checked{% endif %}>
            {{ __('I understand and want to send anyway', 'ticketmailer') }}
        </label>
    </div>

    <div class="ticketmailer-actions">
        {% if inline|default(false) %}
            <button type="button" class="btn btn-secondary"
                    data-bs-toggle="collapse" data-bs-target="{{ close_target }}">
                {{ __('Cancel', 'ticketmailer') }}
            </button>
        {% else %}
            <a href="{{ path('front/ticket.form.php?id=' ~ tickets_id) }}"
               class="btn btn-secondary" data-bs-dismiss="modal">
                {{ __('Cancel', 'ticketmailer') }}
            </a>
        {% endif %}
        <label class="form-check form-switch d-inline-flex align-items-center mb-0 px-2"
               title="{{ __('Set ticket status to waiting after sending.', 'ticketmailer') }}">
            <i class="ti ti-player-pause me-2" aria-hidden="true"></i>
            <input type="checkbox" class="form-check-input m-0"
                   name="set_waiting" value="1"
                   {% if set_waiting is not defined or set_waiting %}checked{% endif %}>
            <span class="visually-hidden">
                {{ __('Set ticket status to waiting after sending.', 'ticketmailer') }}
            </span>
        </label>
        <label class="form-check form-switch d-inline-flex align-items-center mb-0 px-2"
               title="{{ __('Set ticket status to solved after sending.', 'ticketmailer') }}">
            <i class="ti ti-circle-check me-2" aria-hidden="true"></i>
            <input type="checkbox" class="form-check-input m-0"
                   name="set_solved" value="1"
                   {% if set_solved|default(false) %}checked{% endif %}>
            <span class="visually-hidden">
                {{ __('Set ticket status to solved after sending.', 'ticketmailer') }}
            </span>
        </label>
        {% if can_update_knowledge|default(false) %}
            <label class="form-check form-switch d-inline-flex align-items-center mb-0 px-2"
                   title="{{ __('Save and add to the knowledge base') }}">
                <i class="ti ti-device-floppy me-2" aria-hidden="true"></i>
                <input type="checkbox" class="form-check-input m-0"
                       name="save_knowledge" value="1"
                       {% if save_knowledge|default(false) %}checked{% endif %}>
                <span class="visually-hidden">
                    {{ __('Save and add to the knowledge base') }}
                </span>
            </label>
        {% endif %}
        <button type="submit" class="btn btn-primary"
                {% if mailbox_matches and not mailbox_override %}disabled{% endif %}>
            {{ __('Send', 'ticketmailer') }}
        </button>
    </div>
</form>
</div>
{% if native_followup_form %}
    <div data-ticketmailer-panel="internal_note" hidden aria-hidden="true">
        {{ native_followup_form|raw }}
    </div>
{% endif %}
</div>