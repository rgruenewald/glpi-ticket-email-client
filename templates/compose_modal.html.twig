<div id="{{ modal_name }}" class="modal" tabindex="-1" aria-labelledby="{{ modal_name }}-title"
     data-ticketmailer-compose-modal data-compose-url="{{ url }}">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ modal_name }}-title">{{ title }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>
