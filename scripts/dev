#!/usr/bin/env bash
# Explicit context: never fall back to the system daemon.
set -euo pipefail
cd "$(dirname "$0")/.."
compose() { docker --context rootless compose "$@"; }
case "${1:-help}" in
  prepare)
    mkdir -p _files vendor .phpunit.cache
    command -v setfacl >/dev/null || { echo 'Install acl (setfacl) first.' >&2; exit 1; }
    # Derive the host UID for container www-data (33) from this daemon.
    mapped_uid=$(docker --context rootless run --rm --entrypoint cat ticketmailer/glpi:latest /proc/self/uid_map | awk '$1 <= 33 && 33 < $1 + $3 {print $2 + 33 - $1}')
    test -n "$mapped_uid"
    for dir in inc front ajax templates locales public sql; do
      setfacl -R -m "u:$mapped_uid:rX" "$dir"
      find "$dir" -type d -exec setfacl -m "d:u:$mapped_uid:rX" {} +
    done
    setfacl -m "u:$mapped_uid:r" setup.php hook.php docker/glpi/e2e-fixture.php
    ;;
  interactive)
    compose() { docker --context rootless compose -f docker-compose.yml -f docker/compose.interactive.yml "$@"; }
    cleanup() {
      result=$?
      trap - EXIT INT TERM HUP
      if [ -n "${logs_pid:-}" ]; then
        kill "$logs_pid" 2>/dev/null || true
        wait "$logs_pid" 2>/dev/null || true
      fi
      compose stop glpi db mailpit || result=1
      exit "$result"
    }
    # Serialize interactive owners of the one shared instance across worktrees.
    mkdir -p "$HOME/.local/state/ticketmailer-schema"
    chmod 700 "$HOME/.local/state/ticketmailer-schema"
    exec 9>"$HOME/.local/state/ticketmailer-schema/interactive.lock"
    flock -n 9 || { echo "Another interactive session owns the shared instance." >&2; exit 1; }
    compose build glpi test
    "$0" prepare
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    echo "Interactive worktree: $PWD"
    echo 'Ctrl-C stops GLPI, database and Mailpit; volumes are retained.'
    # Inspect persisted version before GLPI discovery can rewrite it.
    compose stop glpi
    compose up -d --wait --wait-timeout 240 db
    source scripts/dev-plugin.sh
    plugin_preflight
    compose up -d --wait --wait-timeout 240 glpi mailpit
    plugin_apply
    docker --context rootless compose -f docker-compose.yml -f docker/compose.interactive.yml logs --follow --tail 100 glpi db mailpit &
    logs_pid=$!
    wait "$logs_pid"
    ;;
  up)
    compose build glpi test
    "$0" prepare
    compose up -d --wait --wait-timeout 240 glpi mailpit
    ;;
  test)
    compose run --rm test
    node --test tests/*.test.js
    ROOT=. bash scripts/verify/score.sh
    ;;
  e2e)
    npm ci --ignore-scripts
    npx playwright install chromium
    npm run test:e2e
    ;;
  stop) compose stop glpi db mailpit ;;
  logs) compose logs --tail 100 glpi db mailpit ;;
  status) compose ps ;;
  *) echo 'Usage: scripts/dev {interactive|up|prepare|test|e2e|stop|logs|status}' ;;
esac
